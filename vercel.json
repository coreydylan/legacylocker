{
  "buildCommand": "vite build",
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "framework": "vite",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "crons": [],
  "rewrites": [
    { "source": "/admin/:path*", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
} 